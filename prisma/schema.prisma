  users_approvals_decided_byTousers users?            @relation("approvals_decided_byTousers", fields: [decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_approvals_updated_byTousers users?            @relation("approvals_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id], map: "ix_approvals_company")
