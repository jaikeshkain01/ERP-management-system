  ref_type                   String?
  ref_id                     String?                   @db.Uuid
  grn_no                     String?
  reason                     String?
  note                       String?
  created_by                 String?                   @db.Uuid
  created_at                 DateTime                  @default(now()) @db.Timestamptz(6)
  // lot_id and item_variant_id are NOT NULL in the DB but two BEFORE-INSERT
  // triggers (trg_assign_default_lot, trg_inv_txn_sync_item_variant) fill
  // them from component_brand_variant_id when the caller leaves them blank.
  // Marked optional in Prisma types so existing callers that only supply
  // CBV compile; the DB still enforces non-null after the triggers fire.
  lot_id                     String?                   @db.Uuid
  item_variant_id            String?                   @db.Uuid
  item_variants              item_variants?            @relation(fields: [company_id, item_variant_id], references: [company_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inv_txn_item_variant")
  item_lots                  item_lots?                @relation(fields: [company_id, lot_id], references: [company_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inv_txn_lot")
  component_brand_variants   component_brand_variants? @relation(fields: [company_id, component_brand_variant_id], references: [company_id, id], onDelete: NoAction, onUpdate: NoAction)
  companies                  companies                 @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses                 warehouses                @relation(fields: [company_id, warehouse_id], references: [company_id, id], onDelete: NoAction, onUpdate: NoAction)
  storage_locations          storage_locations         @relation(fields: [company_id, warehouse_id, location_id], references: [company_id, warehouse_id, id], onDelete: NoAction, onUpdate: NoAction)
  users                      users?                    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "ix_inv_txn_created")
  @@index([ref_type, ref_id], map: "ix_inv_txn_ref")
  @@index([component_brand_variant_id, warehouse_id], map: "ix_inv_txn_variant_wh")
  @@index([company_id], map: "ix_inventory_transactions_company")
  @@index([company_id, item_variant_id], map: "ix_inv_txn_item_variant")
  @@index([company_id, lot_id], map: "ix_inv_txn_lot")
}

